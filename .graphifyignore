# Graphify ignore rules — same syntax as .gitignore.
# Graphify already honours .gitignore; this file adds the extras that matter
# for a Flutter repo whose *tracked* files still shouldn't reach the graph.
# See docs/GRAPHIFY.md.

# ── Secrets: never ingest, never index, never surface in graph.json ──────────
# .env is gitignored already, but .graphifyignore is the file that still
# applies when anyone runs `graphify extract --no-gitignore`.
.env
.env.*
!.env.example
**/google-services.json
**/GoogleService-Info.plist
**/*.keystore
**/*.jks
**/*.p12
**/*.mobileprovision
lib/core/config/env.g.dart

# ── Generated code: mirrors hand-written sources, doubles node count ─────────
**/*.g.dart
**/*.freezed.dart
**/*.mocks.dart
**/*.config.dart
lib/core/database/drift/**/*.drift.dart

# ── Native shells: platform scaffolding, not app architecture ───────────────
android/
ios/
web/
macos/
linux/
windows/

# ── Build + tooling artefacts ───────────────────────────────────────────────
build/
.dart_tool/
.idea/
.github/
coverage/

# ── Binary / non-source assets ──────────────────────────────────────────────
assets/
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ttf
*.otf
*.json.lock
pubspec.lock

# Graphify's own output — never let the graph index itself.
graphify-out/
