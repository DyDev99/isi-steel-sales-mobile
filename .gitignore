# Environment secrets (Envied source files — never commit; keep .env.example only)
.env
.env.*
!.env.example

# Envied output. Deliberately the ONE generated file that is not committed:
# unlike the drift *.g.dart files, it embeds the obfuscated SAP gateway URL and
# the database salt. Obfuscation is defense-in-depth, not a secret store
# (docs/SECURITY.md §4), so it is regenerated at build time instead.
lib/core/config/env.g.dart

# Miscellaneous
*.class
*.log
*.pyc
*.swp
./docs
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/test/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Graphify knowledge graph (rebuildable artifact: `graphify update .`)
graphify-out/

# Machine-specific Claude Code settings. The graphify PreToolUse hooks embed an
# ABSOLUTE path to the graphify executable, which differs per OS and per user
# (macOS: ~/.local/bin/graphify, Windows: %APPDATA%/uv/tools/.../graphify.exe).
# Committing them breaks every other developer's machine, so each developer
# generates their own with `graphify claude install`. See docs/GRAPHIFY.md.
.claude/settings.local.json

# Gradle writes its build-scan/problems reports here. The root /build/ rule
# above does not cover android/build/, so this artifact was being tracked.
/android/build/
